<Slide style={{ width: '1280px', height: '720px', background: '#1B5E20', overflow: 'hidden', position: 'relative' }}>
  <Animation animType="flyIn" direction="right" duration={600} startType="withPrevious">
    <Image src="assets/log_npc.png" style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 720, objectFit: 'cover' }} />
  </Animation>
  <Animation animType="flyIn" direction="bottom" duration={600} startType="afterPrevious" delay={2200}>
    <Image src="assets/log_mine.png" style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 720, objectFit: 'cover' }} />
  </Animation>
  <Animation animType="fadeIn" duration={600} startType="afterPrevious" delay={800}>
    <Box style={{ position: 'absolute', left: 0, bottom: 54, width: 1280, alignItems: 'center' }}>
      <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#FBF8EF', background: 'rgba(20,50,20,0.72)', padding: '14px 36px', borderRadius: 999, letterSpacing: 4, textShadow: '0 2px 12px rgba(0,0,0,0.5)' }}>村庄升级 · 每日排行</Text>
    </Box>
  </Animation>
</Slide>

<Slide style={{ width: '1280px', height: '720px', background: 'linear-gradient(135deg,#1B5E20 0%,#2E7D32 55%,#66BB6A 100%)', overflow: 'hidden', position: 'relative' }}>
  <Animation animType="zoom" duration={800} startType="withPrevious">
    <Image src="assets/logo.png" style={{ position: 'absolute', left: 540, top: 70, width: 200, height: 200, borderRadius: 22, boxShadow: '0 18px 50px rgba(0,0,0,0.4)' }} />
  </Animation>
  <Animation animType="fadeIn" duration={600} startType="afterPrevious" delay={700}>
    <Box style={{ position: 'absolute', left: 540, top: 300, width: 200, height: 200, borderRadius: 18, background: '#FBF8EF', alignItems: 'center', justifyContent: 'center', boxShadow: '0 14px 40px rgba(0,0,0,0.35)' }}>
      <Text style={{ fontSize: 40 }}>📱</Text>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1B5E20', marginTop: 6 }}>扫码即玩</Text>
    </Box>
  </Animation>
  <Animation animType="fadeIn" duration={600} startType="afterPrevious" delay={500}>
    <Box style={{ position: 'absolute', left: 0, top: 540, width: 1280, alignItems: 'center' }}>
      <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#FBF8EF', letterSpacing: 6, textShadow: '0 2px 12px rgba(0,0,0,0.5)' }}>打开即玩 · 扫码即上</Text>
    </Box>
  </Animation>
  <Animation animType="fadeIn" duration={500} startType="afterPrevious" delay={400}>
    <Box style={{ position: 'absolute', left: 0, top: 612, width: 1280, alignItems: 'center' }}>
      <Text style={{ fontSize: 22, color: '#C9E6B4', letterSpacing: 4 }}>浏览器搜「西米的农场」即可开始</Text>
    </Box>
  </Animation>
</Slide>

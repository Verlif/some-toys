<Slide style={{ width: '1280px', height: '720px', background: '#1B5E20', overflow: 'hidden', position: 'relative' }}>
  <Animation animType="fadeIn" duration={500} startType="withPrevious">
    <Image src="assets/log_farm.png" style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 720, objectFit: 'cover' }} />
  </Animation>
  <Animation animType="zoom" duration={600} startType="afterPrevious" delay={900}>
    <Box style={{ position: 'absolute', right: 230, top: 250, width: 132, height: 132, borderRadius: '50%', background: 'rgba(242,183,5,0.92)', alignItems: 'center', justifyContent: 'center', boxShadow: '0 10px 30px rgba(0,0,0,0.35)' }}>
      <Text style={{ fontSize: 70 }}>🐕</Text>
    </Box>
  </Animation>
  <Animation animType="pulse" duration={900} startType="afterPrevious" delay={500}>
    <Box style={{ position: 'absolute', right: 150, top: 388, background: 'rgba(20,50,20,0.78)', padding: '8px 20px', borderRadius: 999 }}>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FBF8EF' }}>看家护院</Text>
    </Box>
  </Animation>
  <Animation animType="fadeIn" duration={600} startType="afterPrevious" delay={500}>
    <Box style={{ position: 'absolute', left: 0, bottom: 54, width: 1280, alignItems: 'center' }}>
      <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#FBF8EF', background: 'rgba(20,50,20,0.72)', padding: '14px 36px', borderRadius: 999, letterSpacing: 4, textShadow: '0 2px 12px rgba(0,0,0,0.5)' }}>守护犬 · 拦得住的小偷</Text>
    </Box>
  </Animation>
</Slide>

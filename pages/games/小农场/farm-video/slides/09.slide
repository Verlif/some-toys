<Slide style={{ width: '1280px', height: '720px', background: 'linear-gradient(135deg,#145A1B 0%,#2E7D32 50%,#43A047 100%)', overflow: 'hidden', position: 'relative' }}>
  <Animation animType="spin" duration={3000} startType="withPrevious">
    <Box style={{ position: 'absolute', left: 340, top: 40, width: 600, height: 600, borderRadius: '50%', background: 'radial-gradient(circle, rgba(242,183,5,0.18) 0%, transparent 65%)' }} />
  </Animation>
  <Animation animType="zoom" duration={900} startType="withPrevious">
    <Box style={{ position: 'absolute', left: 0, top: 210, width: 1280, alignItems: 'center' }}>
      <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#FBF8EF', letterSpacing: 8, textShadow: '0 4px 24px rgba(0,0,0,0.45)' }}>打开就能玩</Text>
      <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#F2B705', letterSpacing: 8, marginTop: 18, textShadow: '0 4px 24px rgba(0,0,0,0.45)' }}>关掉接着玩</Text>
    </Box>
  </Animation>
</Slide>

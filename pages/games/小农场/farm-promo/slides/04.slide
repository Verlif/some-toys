<Slide style={{ padding: 60, background: '#F4FAEF', display: 'flex', flexDirection: 'column' }}>
  <Animation animType="fadeIn" duration={500}>
    <Box style={{ position: 'relative' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2E9E5B' }}>种满你的 40 块地</Text>
      <Box style={{ width: '100%', height: 1, background: '#2E9E5B', marginTop: 14 }} />
      <Box style={{ position: 'absolute', top: 0, right: 0, width: 44, height: 44, opacity: 0.9 }}>
        <svg width="44" height="44" viewBox="0 0 100 100">
          <path d="M50 94 V40" stroke="#2E9E5B" strokeWidth="6" strokeLinecap="round" fill="none" />
          <path d="M50 58 C30 58 18 44 18 30 C38 30 50 42 50 58 Z" fill="#2E9E5B" />
          <path d="M50 50 C70 50 82 36 82 22 C62 22 50 34 50 50 Z" fill="#7CC47F" />
        </svg>
      </Box>
    </Box>
  </Animation>

  <Animation animType="fadeIn" startType="afterPrevious" duration={500}>
    <Text style={{ fontSize: 19, color: '#4A5A4A', marginTop: 18, lineHeight: 1.5 }}>从一颗小麦到 267 种作物，从 6 块地到 40 块地 —— 农场由你亲手扩张。</Text>
  </Animation>

  <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
    <Box style={{ flexDirection: 'row', marginTop: 26, background: '#FFFFFF', borderRadius: 16, border: '1px solid #E0EFD9', overflow: 'hidden' }}>
      <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center', padding: '30px 10px', borderRight: '1px solid #E0EFD9' }}>
        <Text style={{ fontSize: 92, fontWeight: 'bold', color: '#F2A33C' }}>267</Text>
        <Text style={{ fontSize: 20, color: '#2B3A2B', marginTop: 8 }}>种作物</Text>
      </Box>
      <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center', padding: '30px 10px', borderRight: '1px solid #E0EFD9' }}>
        <Text style={{ fontSize: 92, fontWeight: 'bold', color: '#F2A33C' }}>6</Text>
        <Text style={{ fontSize: 20, color: '#2B3A2B', marginTop: 8 }}>种原型</Text>
      </Box>
      <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center', padding: '30px 10px', borderRight: '1px solid #E0EFD9' }}>
        <Text style={{ fontSize: 92, fontWeight: 'bold', color: '#F2A33C' }}>8</Text>
        <Text style={{ fontSize: 20, color: '#2B3A2B', marginTop: 8 }}>档土地</Text>
      </Box>
      <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center', padding: '30px 10px' }}>
        <Text style={{ fontSize: 92, fontWeight: 'bold', color: '#F2A33C' }}>40</Text>
        <Text style={{ fontSize: 20, color: '#2B3A2B', marginTop: 8 }}>块地块</Text>
      </Box>
    </Box>
  </Animation>

  <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
    <Box style={{ marginTop: 26, background: '#EAF5E2', borderRadius: 12, padding: '18px 24px' }}>
      <Text style={{ fontSize: 18, color: '#2B3A2B', lineHeight: 1.6 }}>照料决定收成：浇水缩短当前阶段 10%，捉虫每只 +10% 产量（上限 +100%）；照顾经验 = 作物等级 ÷ 10。<span style={{ color: '#C0392B', fontWeight: 'bold' }}>欠水 −15%、欠虫 −40%</span> —— 勤快才有好收成。</Text>
    </Box>
  </Animation>

  <Box style={{ marginTop: 16, paddingTop: 12, borderTop: '1px solid #E0EFD9' }}>
    <Text style={{ fontSize: 14, color: '#6E7E6E' }}>西米的农场 · 打开即玩</Text>
  </Box>
</Slide>

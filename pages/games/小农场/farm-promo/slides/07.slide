<Slide style={{ padding: 60, background: '#F4FAEF', display: 'flex', flexDirection: 'column' }}>
  <Animation animType="fadeIn" duration={500}>
    <Box style={{ position: 'relative' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2E9E5B' }}>买张藏宝图，去挖限定种子</Text>
      <Box style={{ width: '100%', height: 1, background: '#2E9E5B', marginTop: 14 }} />
      <Box style={{ position: 'absolute', top: 0, right: 0, width: 44, height: 44, opacity: 0.9 }}>
        <svg width="44" height="44" viewBox="0 0 100 100">
          <path d="M50 94 V40" stroke="#2E9E5B" strokeWidth="6" strokeLinecap="round" fill="none" />
          <path d="M50 58 C30 58 18 44 18 30 C38 30 50 42 50 58 Z" fill="#2E9E5B" />
          <path d="M50 50 C70 50 82 36 82 22 C62 22 50 34 50 50 Z" fill="#7CC47F" />
        </svg>
      </Box>
    </Box>
  </Animation>

  <Box style={{ flex: 1, flexDirection: 'row', gap: 44, alignItems: 'center', marginTop: 24 }}>
    <Animation animType="zoom" startType="afterPrevious" duration={600}>
      <Box style={{ width: 360, height: 372, borderRadius: 18, background: 'linear-gradient(150deg, #F2A33C, #E08A1E)', alignItems: 'center', justifyContent: 'center', gap: 14, boxShadow: '0 10px 28px rgba(242,163,60,0.28)' }}>
        <svg width="120" height="120" viewBox="0 0 100 100">
          <rect x="12" y="14" width="76" height="72" rx="8" fill="none" stroke="#FFFFFF" strokeWidth="4" />
          <path d="M26 72 Q40 42 56 54 T80 30" fill="none" stroke="#FFFFFF" strokeWidth="3" strokeDasharray="5 5" />
          <circle cx="80" cy="30" r="6" fill="#FFFFFF" />
          <path d="M22 26 L30 34 M30 26 L22 34" stroke="#FFFFFF" strokeWidth="3" strokeLinecap="round" />
        </svg>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>藏宝图</Text>
        <Text style={{ fontSize: 17, color: '#FFF3E0', textAlign: 'center', lineHeight: 1.5 }}>5 档 · 等级与金币达标可进</Text>
      </Box>
    </Animation>

    <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 18 }}>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
          <Box style={{ width: 10, height: 10, borderRadius: 3, background: '#F2A33C', marginTop: 9 }} />
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>走格子收集</Text>
            <Text style={{ fontSize: 18, color: '#4A5A4A', marginTop: 6, lineHeight: 1.5 }}>金币 / 道具 / 限定种子 / 稀有犬种</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
          <Box style={{ width: 10, height: 10, borderRadius: 3, background: '#F2A33C', marginTop: 9 }} />
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>限定种子只能挖</Text>
            <Text style={{ fontSize: 18, color: '#4A5A4A', marginTop: 6, lineHeight: 1.5 }}>商店买不到，是藏宝图的专属收获</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
          <Box style={{ width: 10, height: 10, borderRadius: 3, background: '#F2A33C', marginTop: 9 }} />
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>5 档难度</Text>
            <Text style={{ fontSize: 18, color: '#4A5A4A', marginTop: 6, lineHeight: 1.5 }}>等级与金币都要达标，越深越值钱</Text>
          </Box>
        </Box>
        <Box style={{ background: '#FFF6E9', borderRadius: 10, padding: '14px 18px', borderLeft: '4px solid #F2A33C' }}>
          <Text style={{ fontSize: 17, color: '#7A5A1E', lineHeight: 1.5 }}>限定种子是身份象征 —— 集齐图鉴、冲称号，多半靠它。</Text>
        </Box>
      </Box>
    </Animation>
  </Box>

  <Box style={{ marginTop: 16, paddingTop: 12, borderTop: '1px solid #E0EFD9' }}>
    <Text style={{ fontSize: 14, color: '#6E7E6E' }}>西米的农场 · 打开即玩</Text>
  </Box>
</Slide>

<Slide style={{ padding: 60, background: '#F4FAEF', display: 'flex', flexDirection: 'column' }}>
  <Animation animType="fadeIn" duration={500}>
    <Box style={{ position: 'relative' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2E9E5B' }}>技术也很轻</Text>
      <Box style={{ width: '100%', height: 1, background: '#2E9E5B', marginTop: 14 }} />
      <Box style={{ position: 'absolute', top: 0, right: 0, width: 44, height: 44, opacity: 0.9 }}>
        <svg width="44" height="44" viewBox="0 0 100 100">
          <path d="M50 94 V40" stroke="#2E9E5B" strokeWidth="6" strokeLinecap="round" fill="none" />
          <path d="M50 58 C30 58 18 44 18 30 C38 30 50 42 50 58 Z" fill="#2E9E5B" />
          <path d="M50 50 C70 50 82 36 82 22 C62 22 50 34 50 50 Z" fill="#7CC47F" />
        </svg>
      </Box>
    </Box>
  </Animation>

  <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 28, alignItems: 'stretch', marginTop: 26 }}>
      <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 16, border: '1px solid #E0EFD9', padding: 28, flexDirection: 'column', gap: 14 }}>
        <Box style={{ width: 56, height: 56, borderRadius: 14, background: '#EAF5E2', alignItems: 'center', justifyContent: 'center' }}>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#2E9E5B" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round"><path d="M8 8 L4 12 L8 16" /><path d="M16 8 L20 12 L16 16" /></svg>
        </Box>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#2B3A2B' }}>零构建</Text>
        <Text style={{ fontSize: 18, color: '#4A5A4A', lineHeight: 1.6 }}>原生 ESM + IndexedDB，打开网页就能跑，改完刷新即生效。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 16, border: '1px solid #E0EFD9', padding: 28, flexDirection: 'column', gap: 14 }}>
        <Box style={{ width: 56, height: 56, borderRadius: 14, background: '#EAF5E2', alignItems: 'center', justifyContent: 'center' }}>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#2E9E5B" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 4 V14" /><path d="M8 10 L12 14 L16 10" /><path d="M5 19 H19" /></svg>
        </Box>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#2B3A2B' }}>可离线</Text>
        <Text style={{ fontSize: 18, color: '#4A5A4A', lineHeight: 1.6 }}>支持 PWA，添加到主屏幕就能离线游玩，不被 7 天清理坑。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 16, border: '1px solid #E0EFD9', padding: 28, flexDirection: 'column', gap: 14 }}>
        <Box style={{ width: 56, height: 56, borderRadius: 14, background: '#EAF5E2', alignItems: 'center', justifyContent: 'center' }}>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#2E9E5B" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><path d="M3 9 A12 12 0 0 1 21 9" /><path d="M6 12.5 A8 8 0 0 1 18 12.5" /><circle cx="12" cy="17" r="1.6" fill="#2E9E5B" stroke="none" /></svg>
        </Box>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#2B3A2B' }}>能联机</Text>
        <Text style={{ fontSize: 18, color: '#4A5A4A', lineHeight: 1.6 }}>同 WiFi 填相同村镇名，和朋友见面（WebRTC P2P）。</Text>
      </Box>
    </Box>
  </Animation>

  <Box style={{ marginTop: 16, paddingTop: 12, borderTop: '1px solid #E0EFD9', flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#6E7E6E' }}>西米的农场 · 打开即玩</Text>
    <Text style={{ fontSize: 14, color: '#6E7E6E' }}>开发者友好：npm run check 一行静态校验</Text>
  </Box>
</Slide>

<Slide style={{ padding: 60, background: '#F4FAEF', display: 'flex', flexDirection: 'column' }}>
  <Animation animType="fadeIn" duration={500}>
    <Box style={{ position: 'relative' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2E9E5B' }}>每天 14:00，和全村比一比</Text>
      <Box style={{ width: '100%', height: 1, background: '#2E9E5B', marginTop: 14 }} />
      <Box style={{ position: 'absolute', top: 0, right: 0, width: 44, height: 44, opacity: 0.9 }}>
        <svg width="44" height="44" viewBox="0 0 100 100">
          <path d="M50 94 V40" stroke="#2E9E5B" strokeWidth="6" strokeLinecap="round" fill="none" />
          <path d="M50 58 C30 58 18 44 18 30 C38 30 50 42 50 58 Z" fill="#2E9E5B" />
          <path d="M50 50 C70 50 82 36 82 22 C62 22 50 34 50 50 Z" fill="#7CC47F" />
        </svg>
      </Box>
    </Box>
  </Animation>

  <Box style={{ flex: 1, flexDirection: 'row', gap: 40, alignItems: 'center', marginTop: 24 }}>
    <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
          <Box style={{ width: 10, height: 10, borderRadius: 3, background: '#F2A33C', marginTop: 9 }} />
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>11 张排行榜</Text>
            <Text style={{ fontSize: 18, color: '#4A5A4A', marginTop: 6, lineHeight: 1.5 }}>每天 14:00 准时开奖，实时榜同步更新</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
          <Box style={{ width: 10, height: 10, borderRadius: 3, background: '#F2A33C', marginTop: 9 }} />
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>前三名有奖</Text>
            <Text style={{ fontSize: 18, color: '#4A5A4A', marginTop: 6, lineHeight: 1.5 }}>并列也一起发，不内卷</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
          <Box style={{ width: 10, height: 10, borderRadius: 3, background: '#F2A33C', marginTop: 9 }} />
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>榜单很丰富</Text>
            <Text style={{ fontSize: 18, color: '#4A5A4A', marginTop: 6, lineHeight: 1.5 }}>最友善 / 狗狗王 / 打理王 / 送礼达人 / 农事劳模 / 冒险王…</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
          <Box style={{ width: 10, height: 10, borderRadius: 3, background: '#F2A33C', marginTop: 9 }} />
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>村庄会长大</Text>
            <Text style={{ fontSize: 18, color: '#4A5A4A', marginTop: 6, lineHeight: 1.5 }}>投入金币水晶祈福升级，解锁荣耀种子</Text>
          </Box>
        </Box>
        <Box style={{ background: '#EAF5E2', borderRadius: 10, padding: '14px 18px' }}>
          <Text style={{ fontSize: 17, color: '#2B3A2B', lineHeight: 1.5 }}>村民随村庄升级变多，最多 52 位一起热闹。</Text>
        </Box>
      </Box>
    </Animation>

    <Animation animType="flyIn" direction="right" startType="afterPrevious" duration={600}>
      <Box style={{ width: 520, borderRadius: 16, overflow: 'hidden', border: '1px solid #D8EBD2', boxShadow: '0 8px 24px rgba(46,158,91,0.12)' }}>
        <Image src="assets/log_farm.png" style={{ width: 520, height: 366, objectFit: 'cover', display: 'block' }} />
      </Box>
    </Animation>
  </Box>

  <Box style={{ marginTop: 16, paddingTop: 12, borderTop: '1px solid #E0EFD9' }}>
    <Text style={{ fontSize: 14, color: '#6E7E6E' }}>西米的农场 · 打开即玩</Text>
  </Box>
</Slide>

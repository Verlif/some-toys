<Slide style={{ background: 'linear-gradient(155deg, #2E9E5B 0%, #3FB56B 55%, #57C277 100%)', padding: 60, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center' }}>
  <Animation animType="zoom" duration={700}>
    <Box style={{ width: 150, height: 150, alignItems: 'center', justifyContent: 'center', marginBottom: 18 }}>
      <svg width="130" height="130" viewBox="0 0 100 100">
        <path d="M50 94 V44" stroke="#FFFFFF" strokeWidth="5" strokeLinecap="round" fill="none" />
        <path d="M50 60 C28 60 16 45 16 30 C36 30 50 43 50 60 Z" fill="#FFFFFF" />
        <path d="M50 52 C72 52 84 37 84 22 C64 22 50 35 50 52 Z" fill="#FFFFFF" />
        <circle cx="50" cy="44" r="5" fill="#F2A33C" />
      </svg>
    </Box>
  </Animation>

  <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
    <Text style={{ fontSize: 76, fontWeight: 'bold', color: '#FFFFFF', textShadow: '2px 3px 10px rgba(0,0,0,0.18)', letterSpacing: 4 }}>西米的农场</Text>
  </Animation>

  <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
    <Text style={{ fontSize: 28, color: '#F0FBF1', opacity: 0.96, marginTop: 14, letterSpacing: 2 }}>一个温暖的网页农场小游戏</Text>
  </Animation>

  <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
    <Box style={{ width: 320, height: 1, background: 'rgba(255,255,255,0.6)', margin: '26px 0' }} />
  </Animation>

  <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
    <Text style={{ fontSize: 24, color: '#FFFFFF', opacity: 0.95, letterSpacing: 3 }}>种地 · 串门 · 偷菜 · 养狗，打开浏览器就能玩</Text>
  </Animation>

  <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
    <Box style={{ marginTop: 40, padding: '10px 26px', borderRadius: 999, background: 'rgba(255,255,255,0.18)', border: '1px solid rgba(255,255,255,0.45)' }}>
      <Text style={{ fontSize: 18, color: '#FFFFFF', letterSpacing: 2 }}>零注册 · 零下载 · 本地存档</Text>
    </Box>
  </Animation>
</Slide>

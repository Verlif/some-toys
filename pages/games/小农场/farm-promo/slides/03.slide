<Slide style={{ padding: 60, background: '#F4FAEF', display: 'flex', flexDirection: 'column' }}>
  <Animation animType="fadeIn" duration={500}>
    <Box style={{ position: 'relative' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2E9E5B' }}>一个越玩越上头的循环</Text>
      <Box style={{ width: '100%', height: 1, background: '#2E9E5B', marginTop: 14 }} />
      <Box style={{ position: 'absolute', top: 0, right: 0, width: 44, height: 44, opacity: 0.9 }}>
        <svg width="44" height="44" viewBox="0 0 100 100">
          <path d="M50 94 V40" stroke="#2E9E5B" strokeWidth="6" strokeLinecap="round" fill="none" />
          <path d="M50 58 C30 58 18 44 18 30 C38 30 50 42 50 58 Z" fill="#2E9E5B" />
          <path d="M50 50 C70 50 82 36 82 22 C62 22 50 34 50 50 Z" fill="#7CC47F" />
        </svg>
      </Box>
    </Box>
  </Animation>

  <Box style={{ flex: 1, justifyContent: 'center' }}>
    <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
        <Box style={{ flex: 1, background: '#EAF5E2', borderRadius: 14, padding: '24px 14px', alignItems: 'center', gap: 10 }}>
          <Box style={{ width: 46, height: 46, borderRadius: '50%', background: '#2E9E5B', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 22, color: '#fff', fontWeight: 'bold' }}>1</Text></Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>种地</Text>
          <Text style={{ fontSize: 15, color: '#6E7E6E', textAlign: 'center', lineHeight: 1.4 }}>选种子 · 开垦地块</Text>
        </Box>
        <Box style={{ width: 34, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 30, color: '#2E9E5B', fontWeight: 'bold' }}>→</Text></Box>
        <Box style={{ flex: 1, background: '#EAF5E2', borderRadius: 14, padding: '24px 14px', alignItems: 'center', gap: 10 }}>
          <Box style={{ width: 46, height: 46, borderRadius: '50%', background: '#2E9E5B', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 22, color: '#fff', fontWeight: 'bold' }}>2</Text></Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>照料</Text>
          <Text style={{ fontSize: 15, color: '#6E7E6E', textAlign: 'center', lineHeight: 1.4 }}>浇水 · 捉虫</Text>
        </Box>
        <Box style={{ width: 34, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 30, color: '#2E9E5B', fontWeight: 'bold' }}>→</Text></Box>
        <Box style={{ flex: 1, background: '#EAF5E2', borderRadius: 14, padding: '24px 14px', alignItems: 'center', gap: 10 }}>
          <Box style={{ width: 46, height: 46, borderRadius: '50%', background: '#2E9E5B', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 22, color: '#fff', fontWeight: 'bold' }}>3</Text></Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>收获</Text>
          <Text style={{ fontSize: 15, color: '#6E7E6E', textAlign: 'center', lineHeight: 1.4 }}>成熟 · 采收</Text>
        </Box>
        <Box style={{ width: 34, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 30, color: '#2E9E5B', fontWeight: 'bold' }}>→</Text></Box>
        <Box style={{ flex: 1, background: '#EAF5E2', borderRadius: 14, padding: '24px 14px', alignItems: 'center', gap: 10 }}>
          <Box style={{ width: 46, height: 46, borderRadius: '50%', background: '#2E9E5B', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 22, color: '#fff', fontWeight: 'bold' }}>4</Text></Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>卖钱</Text>
          <Text style={{ fontSize: 15, color: '#6E7E6E', textAlign: 'center', lineHeight: 1.4 }}>仓库 · 交易</Text>
        </Box>
        <Box style={{ width: 34, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 30, color: '#2E9E5B', fontWeight: 'bold' }}>→</Text></Box>
        <Box style={{ flex: 1, background: '#EAF5E2', borderRadius: 14, padding: '24px 14px', alignItems: 'center', gap: 10 }}>
          <Box style={{ width: 46, height: 46, borderRadius: '50%', background: '#F2A33C', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 22, color: '#fff', fontWeight: 'bold' }}>5</Text></Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2B3A2B' }}>升级</Text>
          <Text style={{ fontSize: 15, color: '#6E7E6E', textAlign: 'center', lineHeight: 1.4 }}>土地 · 解锁</Text>
        </Box>
      </Box>
    </Animation>

    <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
      <Box style={{ marginTop: 28, background: '#FFF6E9', borderLeft: '4px solid #F2A33C', borderRadius: 10, padding: '16px 22px' }}>
        <Text style={{ fontSize: 19, color: '#7A5A1E', lineHeight: 1.5 }}>浇水缩短当前阶段、捉虫提升产量；等级越高解锁越多作物与土地 —— 升级后种更好的种子，循环继续。</Text>
      </Box>
    </Animation>
  </Box>

  <Box style={{ marginTop: 16, paddingTop: 12, borderTop: '1px solid #E0EFD9' }}>
    <Text style={{ fontSize: 14, color: '#6E7E6E' }}>西米的农场 · 打开即玩</Text>
  </Box>
</Slide>
